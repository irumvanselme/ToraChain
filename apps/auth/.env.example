# Shared secret used to sign sessions/JWTs across all three domains. (required)
BETTER_AUTH_SECRET=

# Single Postgres database shared by all three identity domains. Each domain's
# better-auth tables are namespaced by prefix (voter_*, admin_*, auditor_*),
# plus a shared `api_keys` table for the /core API. (required)
AUTH_DB_URI=

# Port the server listens on. (optional, default 3000; dev .env uses 8001)
PORT=8001

# Selects the URL set resolved by @tora-chain/configs: `development` uses the
# *.localhost hosts, `production` maps to the demo deployment. The service's
# baseURL and trusted origins are derived from those links, NOT from env vars.
NODE_ENV=development

# Optional logging controls (consumed by @tora-chain/be-common's Logger).
# LOG_LEVEL=info
# LOG_PRETTY=true
