# Postgres database backing the elections API. (required)
ELECTIONS_DB_URI=postgres://elections:elections@localhost:5433/elections

# Port the elections API listens on. (optional, default 3001; dev .env uses 8000)
PORT=8000

# Selects the URL set resolved by @tora-chain/configs: `development` uses the
# *.localhost hosts, `production` maps to the demo deployment. The auth /core
# URL and trusted origins are derived from those links, NOT from env vars.
NODE_ENV=development

# API key for the auth /core API, used to look up voters by user id when
# granting eligibility. When unset, voter lookups are disabled (NullAuthCore).
# The /core base URL itself comes from @tora-chain/configs (idpLink).
# (optional)
AUTH_CORE_API_KEY=

# URL of the chain-node master. When set, each cast vote is forwarded to the
# blockchain network as a fire-and-forget audit trail (else NullChainNodeClient).
# (optional)
# CHAIN_NODE_URL=http://localhost:7100

# Postgres used by the integration test suite only (test:integration).
# VITE_TEST_DATABASE_URI=

# Optional logging controls (consumed by @tora-chain/be-common's Logger).
# LOG_LEVEL=info
# LOG_PRETTY=true
