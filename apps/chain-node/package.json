{
  "name": "@tora-chain/chain-node",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:master": "bun run --watch src/start.ts --master --port 7100",
    "dev:worker": "bun run --watch src/start.ts --port 7101 --master-url ws://localhost:7100",
    "start": "bun run src/start.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@tora-chain/blockchain": "workspace:*",
    "@tora-chain/specs": "workspace:*",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.1",
    "typescript": "^5"
  }
}
