# Master node persistence (Postgres). When unset, the master falls back to a
# local JSON file — fine for local dev, not for deployments.
CHAIN_DB_URI=postgres://user:password@localhost:5432/torachain

# Google Cloud Pub/Sub — required by both master and worker nodes; there is
# no local fallback (unlike CHAIN_DB_URI, Pub/Sub is load-bearing for block
# propagation from the master publisher to the worker subscribers). The topic
# and subscriptions are created on demand if they don't already exist
# (iac/terraform/pubsub.tf provisions them in deployments).
#
# For local dev, run the Pub/Sub emulator (`make torachain-cli-pubsub-emulator`
# from the repo root, or `gcloud beta emulators pubsub start
# --host-port=localhost:8085`) and point at it with PUBSUB_EMULATOR_HOST —
# no real GCP project needed.
GOOGLE_CLOUD_PROJECT=torachain-local
PUBSUB_EMULATOR_HOST=localhost:8085

# Unset PUBSUB_EMULATOR_HOST to talk to real GCP Pub/Sub instead. Cloud Run
# picks up credentials automatically from its attached service account; a
# node running elsewhere (e.g. a community worker) needs a service-account
# key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/torachain-worker-key.json
