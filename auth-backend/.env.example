# ---- HTTP server ----
PORT=3000
NODE_ENV=development

# ---- better-auth ----
# Generate a strong secret, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_BASE_PATH=/api/auth
# Comma-separated list of origins allowed to call the API (CORS + CSRF).
TRUSTED_ORIGINS=http://localhost:3000

# ---- Auth Postgres ----
# Matches the `auth-db` service in iac/dev-data.docker-compose.yaml
# (host port 5434 -> container 5432, user/password/db all `auth`).
# Either set AUTH_DATABASE_URL, or the discrete fields below.
# AUTH_DATABASE_URL=postgresql://auth:auth@localhost:5434/auth
AUTH_DATABASE_HOST=localhost
AUTH_DATABASE_PORT=5434
AUTH_DATABASE_USER=auth
AUTH_DATABASE_PASSWORD=auth
AUTH_DATABASE_NAME=auth
AUTH_DATABASE_SSL=false
AUTH_DATABASE_POOL_MAX=10

# ---- Logging ----
LOG_LEVEL=debug
LOG_PRETTY=true
