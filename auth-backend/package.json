{
  "name": "auth-backend",
  "module": "app/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch app/server.ts",
    "start": "bun run app/server.ts",
    "auth:generate": "bun x @better-auth/cli@latest generate --config app/auth.ts --output app/db/schema.ts -y",
    "db:generate": "bun x drizzle-kit generate",
    "db:migrate": "bun x drizzle-kit migrate",
    "db:push": "bun x drizzle-kit push"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@tora-chain/be-common": "workspace:*",
    "better-auth": "^1.6.14",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
