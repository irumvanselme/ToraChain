# Shared secret used to sign sessions/JWTs across all three domains.
BETTER_AUTH_SECRET=

# Public base URL of this service (used by better-auth + reset links).
BETTER_AUTH_URL=http://localhost:3000

# Port the server listens on.
PORT=3000

# Optional: comma-separated origins allowed to call the API with credentials.
# Defaults to BETTER_AUTH_URL when unset.
TRUSTED_ORIGINS=

# One Postgres database per identity domain.
ADMINS_AUTH_DB_URI=
VOTERS_AUTH_DB_URI=
AUDITORS_AUTH_DB_URI=
