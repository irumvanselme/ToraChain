# Shared secret used to sign sessions/JWTs across all three domains.
BETTER_AUTH_SECRET=

# Public base URL of this service (used by better-auth + reset links).
BETTER_AUTH_URL=http://localhost:3000

# Port the server listens on.
PORT=3000

# Optional: comma-separated origins allowed to call the API with credentials.
# Defaults to BETTER_AUTH_URL when unset.
TRUSTED_ORIGINS=

# Single Postgres database shared by all three identity domains. Each domain's
# better-auth tables are namespaced by prefix (voter_*, admin_*, auditor_*),
# plus a shared `api_keys` table for the /core API.
AUTH_DB_URI=
