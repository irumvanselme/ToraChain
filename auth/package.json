{
  "name": "@torachain/auth",
  "module": "app/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch app/server.ts",
    "start": "bun run app/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "health-check": "bun run scripts/health-check.ts",
    "generate:voters": "bunx @better-auth/cli@latest generate --config app/auth/voters.ts --output migrations/voters.sql -y",
    "generate:admins": "bunx @better-auth/cli@latest generate --config app/auth/admins.ts --output migrations/admins.sql -y",
    "generate:auditors": "bunx @better-auth/cli@latest generate --config app/auth/auditors.ts --output migrations/auditors.sql -y",
    "generate:all": "bun run generate:voters && bun run generate:admins && bun run generate:auditors",
    "migrate:voters": "bunx @better-auth/cli@latest migrate --config app/auth/voters.ts -y",
    "migrate:admins": "bunx @better-auth/cli@latest migrate --config app/auth/admins.ts -y",
    "migrate:auditors": "bunx @better-auth/cli@latest migrate --config app/auth/auditors.ts -y",
    "migrate:all": "bun run migrate:voters && bun run migrate:admins && bun run migrate:auditors"
  },
  "dependencies": {
    "@elysia/html": "^1.4.1",
    "@elysiajs/cors": "^1.4.2",
    "@tora-chain/be-common": "workspace:*",
    "better-auth": "^1.6.14",
    "elysia": "^1.4.28",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
