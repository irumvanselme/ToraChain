# Port the elections API listens.
PORT=8000

AUTH_SERVICE_URL=http://localhost:8001

# Auth /core API used to look up voters by user id when granting eligibility.
# Set both to enable it. AUTH_CORE_URL defaults to AUTH_SERVICE_URL when unset.
AUTH_CORE_URL=http://localhost:8001
AUTH_CORE_API_KEY=

# Optional: comma-separated origins allowed to call the API with credentials.
# Defaults to AUTH_SERVICE_URL when unset.
TRUSTED_ORIGINS=

# Postgres database backing
ELECTIONS_DB_URI=postgres://elections:elections@localhost:5433/elections

# Optional logging controls.
# LOG_LEVEL=info
# LOG_PRETTY=true
