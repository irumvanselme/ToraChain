# Bun service (auth, backend).
# Build context: repo root.
# Required build arg: APP_DIR — workspace sub-path (e.g. auth, backend).
FROM oven/bun:1.2-alpine
WORKDIR /app

COPY . .
RUN bun install --frozen-lockfile

ARG APP_DIR
ENV APP_DIR=${APP_DIR}

EXPOSE 8080
# Cloud Run injects $PORT (matches container_port in Terraform = 8080).
# The Bun apps read PORT via their env.ts config.
CMD ["sh", "-c", "exec bun run --cwd /app/apps/${APP_DIR} start"]
